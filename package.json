{
  "name": "aetna-health-coding-challenge",
  "version": "1.0.0",
  "description": "Movie Services API - A NestJS application with TypeORM and SQLite databases",
  "scripts": {
    "build": "cd movie-services && npm run build",
    "start": "cd movie-services && npm start",
    "start:dev": "cd movie-services && npm run start:dev",
    "start:debug": "cd movie-services && npm run start:debug",
    "start:prod": "cd movie-services && npm run start:prod",
    "install": "cd movie-services && npm install",
    "test": "cd movie-services && npm test",
    "test:watch": "cd movie-services && npm run test:watch",
    "test:cov": "cd movie-services && npm run test:cov",
    "test:e2e": "cd movie-services && npm run test:e2e",
    "lint": "cd movie-services && npm run lint",
    "format": "cd movie-services && npm run format",
    "clean": "cd movie-services && rm -rf dist node_modules",
    "clean:install": "npm run clean && npm run install",
    "dev": "npm run start:dev"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "keywords": [
    "nestjs",
    "movie-api",
    "typescript",
    "sqlite",
    "typeorm",
    "pino",
    "logging"
